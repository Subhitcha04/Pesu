# Pesu configuration. Every variable is optional: the app starts with no .env file and no API keys.
# docker compose reads this file if you copy it to .env.

# Initial therapist PIN, 4-6 digits. Once changed in the app, the stored PIN wins. Default 1234.
PESU_THERAPIST_PIN=1234
# Background noise level (RMS 0-1) above which Pesu pauses before listening. Default 0.05.
PESU_NOISE_THRESHOLD=0.05
# Time zone for "today" and per-day charts (IANA name). Default Asia/Kolkata.
PESU_TZ=Asia/Kolkata
# 1 = seed the sample child and show Judge Mode. Code default 0; docker-compose.yml sets 1.
PESU_DEMO=1
# Top recogniser confidence below this turns a definite verdict into "unsure" (0-1, uncalibrated). Default 0.35.
PESU_MIN_CONF=0.35
# Where the database, audio and the token secret live. Default ./data (Docker: /srv/data).
PESU_DATA_DIR=./data
# Child audio older than this many days is deleted at startup; verdict rows are kept. Default 90.
PESU_AUDIO_RETENTION_DAYS=90
# Token-signing secret file. Default <PESU_DATA_DIR>/secret.key, created on first run.
PESU_SECRET_FILE=
# Largest accepted audio upload in bytes. Default 2097152 (2 MB).
PESU_MAX_AUDIO_BYTES=2097152
